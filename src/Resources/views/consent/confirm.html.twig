{% extends '@LleHermes/consent/_message_page.html.twig' %}

{% block consent_message %}
    <p class="h5">
        {% if value %}
            {{ 'text.consentAccepted'|trans({}, 'LleHermesBundle') }}
        {% else %}
            {{ 'text.consentRefused'|trans({}, 'LleHermesBundle') }}
        {% endif %}
    </p>
{% endblock %}
